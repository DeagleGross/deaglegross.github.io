---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Dmitry</h1>
			<p>
				I'm a software engineer working on <a href="https://github.com/dotnet/aspnetcore"
					>dotnet/aspnetcore</a
				>. I mostly write C#, and I mostly think about servers, performance, and the parts of the
				stack that only get interesting once something breaks.
			</p>
			<p>
				This is where I write down the things worth remembering: ASP.NET Core internals, benchmarks
				and allocation hunts, diagnostics workflows, and short notes I would otherwise have to look
				up twice.
			</p>

			<h2>Recent posts</h2>
			<ul class="recent-posts">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<span class="date">
								<FormattedDate date={post.data.pubDate} />
							</span>
							<p>{post.data.description}</p>
						</li>
					))
				}
			</ul>

			<p><a href="/blog">Browse all posts</a></p>
			<p>
				There is also an <a href="/rss.xml">RSS feed</a> if you prefer reading things on your own terms.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.recent-posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.recent-posts li {
		margin-bottom: 1.5em;
	}
	.recent-posts li > a {
		font-size: 1.15em;
		font-weight: 700;
	}
	.recent-posts .date {
		display: block;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	.recent-posts p {
		margin: 0.25em 0 0;
	}
</style>
