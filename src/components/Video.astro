---
interface Props {
	/** URL for the video file. Import a colocated file in MDX, or use a `/…` path for files in `public/`. */
	src: string;
	/** Still frame shown before playback. Without one the browser shows a blank box until the user hits play. */
	poster?: string;
	caption?: string;
	/**
	 * Plays automatically on loop with no sound — the usual treatment for short
	 * screen recordings, and a much smaller alternative to an animated GIF.
	 * Browsers block autoplay unless the video is muted, so `muted` is forced on.
	 */
	autoplay?: boolean;
	controls?: boolean;
}

const { src, poster, caption, autoplay = false, controls = true } = Astro.props;
---

<figure class="video">
	<video
		src={src}
		poster={poster}
		controls={controls}
		autoplay={autoplay}
		loop={autoplay}
		muted={autoplay}
		playsinline
		preload="metadata"></video>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.video {
		margin: 0 0 2em 0;
	}
	.video video {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 8px;
		background: rgb(var(--gray-dark));
	}
	.video figcaption {
		margin-top: 0.5em;
		font-size: 0.85em;
		color: rgb(var(--gray));
		text-align: center;
	}
</style>
